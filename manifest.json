{
  "manifest_version": 3,
  "name": "Diamond Valley 自動遊玩",
  "version": "0.4.4",
  "description": "依即時狀態自動釣魚、挖礦及打怪，含隨機輪替與斷線恢復；Boss、寶庫為測試模式。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://diamondvalley.withgoogle.com/intl/ALL_tw/game/*"
      ],
      "js": [
        "settings.js",
        "planner.js",
        "activities.js",
        "navigation.js",
        "main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://diamondvalley.withgoogle.com/intl/ALL_tw/game/*"
      ],
      "js": [
        "settings.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}